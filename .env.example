# Copiar a .env (nunca versionar .env)
# vLLM propio en AMD Developer Cloud (OpenAI-compatible)
AMD_VLLM_ENDPOINT=
AMD_VLLM_API_KEY=
AMD_VLLM_MODEL=google/gemma-4-31B-it

# Evolus (workspace del evento, creado desde el enlace del 12 oct)
EVOLUS_API_BASE=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
EVOLUS_WORKFLOW_ID=

# Gemma en la API de Gemini (solo para depurar prompts; ningún número reportado sale de aquí)
GOOGLE_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-31b-it

# Ollama local
OLLAMA_ENDPOINT=http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:e2b-it-qat
